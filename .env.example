# Copy to .env and fill in. (Photon's `bun create spectrum-project ... --projectId` fills the first two for you.)

# Photon project: https://app.photon.codes -> your project -> Settings
PROJECT_ID=your-photon-project-id
PROJECT_SECRET=your-photon-project-secret

# Claude API key (optional: built-in messages are used without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Tuning
PORT=3000
ALERT_COOLDOWN_MINUTES=10

# GitHub Pages: which site may use this server (comma-separated). Empty = any.
ALLOWED_ORIGINS=
SIGNUPS_PER_HOUR=30
